FROM ubuntu:26.04

# Install necessary packages
RUN DEBIAN_FRONTEND=noninteractive \
    apt-get update \
    && apt-get install -y wget bzip2 xz-utils make unzip cppcheck \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ubuntu:26.04 base image already ships with an "ubuntu" user (uid=1000)
# so we just modify the existing user instead of creating a new one.
# Adding to sudo group for GitHub Actions permission compatibility.
RUN usermod -rm -d /home/ubuntu -s /bin/bash -g root -G sudo \
    -u 1001 ubuntu
USER ubuntu
WORKDIR /home/ubuntu